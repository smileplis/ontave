{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "paths": {
      "ontave": [
        "./src/index.ts"
      ],
      "ontave/react": [
        "./src/react.tsx"
      ],
      "ontave/application": [
        "./src/application.ts"
      ],
      "ontave/application/react": [
        "./src/application-react.tsx"
      ],
      "ontave/application/http": [
        "./src/application-http.ts"
      ],
      "ontave/application/node": [
        "./src/application-node.ts"
      ],
      "ontave/application/model": [
        "./src/application-model.ts"
      ],
      "ontave/application/export": [
        "./src/application-export.ts"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "examples/react/**/*.tsx",
    "website/src/**/*.tsx",
    "examples/application/**/*.ts"
  ]
}
