{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "paths": {
      "ontave": [
        "./src/index.ts"
      ],
      "ontave/react": [
        "./src/react.tsx"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "examples/react/**/*.tsx",
    "website/src/**/*.tsx"
  ]
}
