{
  "name": "ontave",
  "version": "0.2.0-alpha.1",
  "description": "Provider-neutral interactive conversations for AI agents: bounded controls, validation, portable replies and React.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/interactive.css",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./styles.css": "./src/interactive.css",
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "default": "./dist/adapters.js"
    }
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "prepack": "npm run build",
    "dev": "npm run build && vite examples/react --host 127.0.0.1",
    "build:example": "npm run build && vite build examples/react",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "example:providers": "npm run build && node examples/providers.mjs",
    "build:website": "npm run build --prefix website"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13.0 <27"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smileplis/ontave.git"
  },
  "homepage": "https://github.com/smileplis/ontave#readme",
  "bugs": {
    "url": "https://github.com/smileplis/ontave/issues"
  }
}
