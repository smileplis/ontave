{
  "name": "ontave",
  "version": "0.2.0-alpha.2",
  "description": "Modular application foundations for LLMs: validated definitions, transactional runtimes, React views and editable source export.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/interactive.css",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "docs",
    "src/application.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./styles.css": "./src/interactive.css",
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "default": "./dist/adapters.js"
    },
    "./application": {
      "types": "./dist/application.d.ts",
      "default": "./dist/application.js"
    },
    "./application/react": {
      "types": "./dist/application-react.d.ts",
      "default": "./dist/application-react.js"
    },
    "./application/http": {
      "types": "./dist/application-http.d.ts",
      "default": "./dist/application-http.js"
    },
    "./application/node": {
      "types": "./dist/application-node.d.ts",
      "default": "./dist/application-node.js"
    },
    "./application/model": {
      "types": "./dist/application-model.d.ts",
      "default": "./dist/application-model.js"
    },
    "./application/export": {
      "types": "./dist/application-export.d.ts",
      "default": "./dist/application-export.js"
    },
    "./application/styles.css": "./src/application.css"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "prepack": "npm run build",
    "dev": "npm run build && vite website --host 127.0.0.1",
    "build:example": "npm run build && vite build examples/react",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "example:providers": "npm run build && node examples/providers.mjs",
    "build:website": "npm run build && vite build website && node scripts/prepare-application-download.mjs && node scripts/verify-website.mjs",
    "dev:example": "npm run build && vite examples/react --host 127.0.0.1",
    "verify:application": "npm run build && node scripts/verify-application.mjs"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13.0 <27"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smileplis/ontave.git"
  },
  "homepage": "https://ontave.daltn.tech/",
  "bugs": {
    "url": "https://github.com/smileplis/ontave/issues"
  }
}
