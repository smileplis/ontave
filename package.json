{
  "name": "ontave",
  "version": "0.1.0-alpha.5",
  "private": false,
  "description": "Evidence-backed operational data and governed ontology evolution for TypeScript applications",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs/API_REFERENCE.md",
    "docs/OPERATOR_RUNBOOK.md",
    "docs/IMPLEMENTATION_STATUS.md",
    "docs/ANNOTATION_RUBRIC.md",
    "examples/node",
    "examples/next-server",
    "docs/QUALITY_REPORT.md",
    "docs/USER_BENEFITS.md",
    "scripts/release-gate.mjs",
    "examples/playground",
    "docs/RELEASE_STATUS.json",
    "scripts/publish-preview.mjs",
    "docs/QUICKSTART.md",
    "examples/supplier-quotes",
    "docs/SUPPLIER_QUOTATION_BENCHMARK.md",
    "benchmarks/quotation-2026-10-23",
    "examples/adaptive-quotes",
    "examples/local",
    "docs/LOCAL_AND_HOSTED.md",
    "docs/ADAPTATION_MILESTONE.md",
    "benchmarks/adaptation-2026-10-23"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js"
    },
    "./studio": {
      "types": "./dist/studio.d.ts",
      "import": "./dist/studio.js"
    },
    "./models/gemini": {
      "types": "./dist/models/gemini.d.ts",
      "import": "./dist/models/gemini.js"
    },
    "./models/groq": {
      "types": "./dist/models/groq.d.ts",
      "import": "./dist/models/groq.js"
    },
    "./models/mistral": {
      "types": "./dist/models/mistral.d.ts",
      "import": "./dist/models/mistral.js"
    },
    "./models/openrouter": {
      "types": "./dist/models/openrouter.d.ts",
      "import": "./dist/models/openrouter.js"
    }
  },
  "bin": {
    "ontave": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:integration": "npm run build && node --test tests/integration/*.test.mjs",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "verify:next": "npm run build && node scripts/verify-next.mjs --offline",
    "verify:node": "npm run build && node scripts/verify-node-flow.mjs",
    "measure:load": "npm run build && node scripts/measure-load.mjs",
    "verify:restore": "npm run build && node scripts/verify-restore.mjs",
    "verify:domains": "npm run build && node scripts/verify-domain-flows.mjs",
    "measure:benefits": "npm run build && node scripts/measure-benefits.mjs",
    "evaluate:live": "npm run build && node scripts/run-semantic-trials.mjs --live",
    "verify:release": "node scripts/release-gate.mjs",
    "prepublishOnly": "node scripts/release-gate.mjs",
    "playground": "npm run build && node dist/cli.js playground",
    "preview:fixtures": "npm run build && node scripts/prepare-preview.mjs",
    "verify:playground": "node scripts/verify-playground.mjs",
    "verify:preview-release": "node scripts/release-gate.mjs --channel=developer-preview",
    "publish:preview": "node scripts/publish-preview.mjs",
    "example:quotes": "npm run build && node scripts/quotation-study.mjs",
    "compare:quotes": "npm run build && node scripts/compare-quotations.mjs",
    "collect:quotes": "node scripts/collect-quotation-trials.mjs",
    "compare:adaptation": "npm run build && node scripts/compare-adaptation.mjs",
    "collect:adaptation": "node scripts/collect-adaptation.mjs",
    "verify:local": "node scripts/verify-local.mjs"
  },
  "dependencies": {
    "canonicalize": "5.1.0",
    "decimal.js": "10.6.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "node": "24.22.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smileplis/ontave.git"
  },
  "homepage": "https://ontave.daltn.tech/",
  "bugs": {
    "url": "https://github.com/smileplis/ontave/issues"
  }
}
