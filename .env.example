# Dedicated Ontave resources only. Never copy Calcy/Daltn connection strings.
ONTAVE_DATABASE_URL=
ONTAVE_MIGRATION_DATABASE_URL=
ONTAVE_RUNTIME_ROLE=ontave_runtime
ONTAVE_WORKSPACE_ID=
ONTAVE_LOCAL_TOKEN=
ONTAVE_CURSOR_SECRET=
# Optional live inference. No key is needed for deterministic tests.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional experimental Groq extraction; explicitly select it in server configuration.
GROQ_API_KEY=
GROQ_MODEL=

# Optional experimental OpenRouter extraction (explicit model; no fallback).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional experimental Mistral (explicit model; no fallback).
MISTRAL_API_KEY=
MISTRAL_MODEL=
